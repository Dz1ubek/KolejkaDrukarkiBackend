# Application Settings
PROJECT_NAME="Kolejka Drukarki 3D API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Settings
HOST="127.0.0.1"
PORT=8000

# Security & JWT
SECRET_KEY="change-this-in-production-very-secret-key-32-chars-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./kolejka.db"

# Initial Superuser (Admin) Seed Credentials
FIRST_SUPERUSER_EMAIL="admin@kolejka.local"
FIRST_SUPERUSER_USERNAME="admin"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"

# File Uploads
UPLOAD_DIR="uploads/prints"

# Pricing formula constants (in grosze, 100 = 1.00 PLN)
BASE_PRINT_FEE_GROSZE=500
COST_PER_GRAM_GROSZE=15
COST_PER_HOUR_GROSZE=300

# CORS Settings (JSON list format)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
